# =============================================================================
# Задание 5. GraphQL-схема сервиса client-info
#
# Эквивалент существующего REST API (контракт Swagger 2.0, basePath /v1).
#
# Покрытие операций REST:
#
#   REST-операция                          GraphQL-операция
#   -------------------------------------  --------------------------------------------
#   GET /v1/clients/{id}                    query { client(id) { id name age } }
#   GET /v1/clients/{id}/documents          query { client(id) { documents { ... } } }
#   GET /v1/clients/{id}/relatives          query { client(id) { relatives { ... } } }
#
# Три эндпоинта REST объединены в один запрос к ресурсу client: потребитель
# сам выбирает, какие поля и под-объекты ему нужны, и получает ровно их
# в одном HTTP-запросе.
# =============================================================================

# --- Кастомные скалярные типы -------------------------------------------------
#
# Вместо «String на всё» — точные типы данных. При 500 атрибутах в карточке
# это экономит и код валидации, и трафик: формат зафиксирован в схеме,
# а не в конвенции.

"""Дата в формате ISO 8601, только дата, например: "2025-03-14"."""
scalar Date

"""Номер телефона в формате E.164, например: "+79161234567"."""
scalar Phone

"""Адрес электронной почты в формате RFC 5322, например: "client@example.com"."""
scalar Email

# --- Сущности ------------------------------------------------------------------

"""
Клиент сервиса.

Корневой ресурс схемы, эквивалент объекта Client из контракта Swagger.
Поля id, name и age — база, всегда доступная без дополнительных запросов;
контакты, документы и родственники — под-объекты, которые потребитель
запрашивает явно, только если они нужны в его сценарии.
"""
type Client {
  """Уникальный идентификатор клиента (в REST передавался как path-параметр {id})."""
  id: ID!

  """ФИО клиента."""
  name: String!

  """Возраст клиента в полных годах."""
  age: Int!

  """Контактные данные клиента: телефоны и электронная почта."""
  contacts: [Contact!]!

  """Документы клиента (паспорт, водительское удостоверение и т. п.)."""
  documents: [Document!]!

  """Родственники клиента (сопритязатели, выгодоприобретатели и т. п.)."""
  relatives: [Relative!]!
}

"""
Документ клиента.

Эквивалент объекта Document из контракта Swagger.
"""
type Document {
  """Уникальный идентификатор записи документа."""
  id: ID!

  """Тип документа, например: "паспорт", "водительское удостоверение"."""
  type: String!

  """Серийный/регистрационный номер документа."""
  number: String!

  """Дата выдачи документа."""
  issueDate: Date!

  """Дата окончания действия документа."""
  expiryDate: Date!
}

"""
Родственник клиента.

Эквивалент объекта Relative из контракта Swagger.
"""
type Relative {
  """Уникальный идентификатор записи о родственнике."""
  id: ID!

  """Тип родства, например: "супруг", "дочь", "родитель"."""
  relationType: String!

  """ФИО родственника."""
  name: String!

  """Возраст родственника в полных годах."""
  age: Int!
}

"""
Контакт клиента.

В упрощённом контракте Swagger отдельного эндпоинта для контактов нет,
но в условии задачи контакты названы одним из отдельных объектов данных
клиента. В GraphQL он лег в карточку клиента как отдельный тип: набор
контактов (несколько телефонов, e-mail) не размывается по плоским полям
Client и масштабируется без изменения его структуры.
"""
type Contact {
  """Уникальный идентификатор записи контакта."""
  id: ID!

  """Номер телефона."""
  phone: Phone

  """Адрес электронной почты."""
  email: Email
}

# --- Точка входа для запросов ----------------------------------------------------

"""
Точка входа GraphQL-схемы.

Покрытие всех операций REST API:
  * client(id) без под-полей закрывает GET /v1/clients/{id};
  * client(id) { documents } закрывает GET /v1/clients/{id}/documents;
  * client(id) { relatives } закрывает GET /v1/clients/{id}/relatives;
  * комбинации под-полей закрывают многообъектные сценарии одним запросом
    вместо нескольких REST-вызовов.
"""
type Query {
  """
  Получить клиента по его идентификатору.

  Эквивалент GET /v1/clients/{id}. Возвращает null, если клиента с таким
  идентификатором не существует (аналог HTTP 404: в GraphQL отсутствие
  ресурса выражается полем null).
  """
  client(
    """Идентификатор клиента — в REST передавался в пути: /v1/clients/{id}."""
    id: ID!
  ): Client
}
